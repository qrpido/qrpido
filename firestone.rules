rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // FUNCIONES DE AYUDA (ZERO TRUST ARCHITECTURE)
    // ==========================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // CORTAFUEGOS ZERO-TRUST: Verifica que el usuario no esté en registro incompleto
    function isVerified() {
      return isAuthenticated() 
             && exists(/databases/$(database)/documents/Directorio/$(request.auth.uid))
             && get(/databases/$(database)/documents/Directorio/$(request.auth.uid)).data.estado_moderacion != 'pendiente';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ASOCIACIÓN DE EQUIPO: Valida token claims o pertenencia a Equipo / Colaboradores
    function isEmployeeOf(negocioId) {
      return isAuthenticated() 
             && (
               request.auth.token.id_negocio_padre == negocioId
               || exists(/databases/$(database)/documents/Directorio/$(negocioId)/Equipo/$(request.auth.uid))
               || exists(/databases/$(database)/documents/Directorio/$(negocioId)/Colaboradores/$(request.auth.uid))
             );
    }

    function isModeradorOrAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/Usuarios_Admin/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAuthenticated() 
             && exists(/databases/$(database)/documents/Usuarios_Admin/$(request.auth.uid))
             && get(/databases/$(database)/documents/Usuarios_Admin/$(request.auth.uid)).data.rol == 'superadmin';
    }

    function isValidString(text, min, max) {
      return text is string && text.size() >= min && text.size() <= max;
    }

    // ==========================================================
    // 0. PERMISOS GLOBALES PARA ESCÁNER PROFUNDO (RADAR Y WMS)
    // ==========================================================
    match /{path=**}/productos/{productoId} {
      allow read: if true; 
    }

    match /{path=**}/stock_ubicaciones/{ubicacionId} {
      allow read: if true; 
    }

    // ==========================================================
    // 1. COLECCIÓN PRINCIPAL: DIRECTORIO
    // ==========================================================
    match /Directorio/{userId} {
      allow read: if true;
      
      // CREACIÓN: Permite al Superadmin dar de alta prospectos de Onboarding (IDs GEO-XXXX)
      // o a usuarios regulares registrar su cuenta inicial como pendiente
      allow create: if isSuperAdmin()
                    || (
                      isOwner(userId)
                      && request.resource.data.keys().hasAll(['nombre', 'email', 'tipo_modelo'])
                      && request.resource.data.premium == false
                      && request.resource.data.estado_moderacion == 'pendiente'
                    );
      
      // ACTUALIZACIÓN
      allow update: if (
                        (isOwner(userId)
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
                              'premium', 
                              'red_afiliados', 
                              'fecha_registro', 
                              'kyc_verificado', 
                              'firma_digital', 
                              'saldo_logistica', 
                              'saldo_comisiones', 
                              'ordenes_validadas', 
                              'intentos_whatsapp', 
                              'total_referidos_entregados', 
                              'estado_aliado', 
                              'requiere_auditoria'
                          ]))
                          // Protege que el dueño no modifique sus saldos prepago/gratis sin pagar
                          && (
                              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['facturacion_control'])
                              || (
                                  (!('facturacion_control' in resource.data) || !('facturas_prepago_saldo' in resource.data.facturacion_control) || request.resource.data.facturacion_control.facturas_prepago_saldo == resource.data.facturacion_control.facturas_prepago_saldo)
                                  && (!('facturacion_control' in resource.data) || !('facturas_cupo_gratis' in resource.data.facturacion_control) || request.resource.data.facturacion_control.facturas_cupo_gratis == resource.data.facturacion_control.facturas_cupo_gratis)
                              )
                          )
                          && (!request.resource.data.keys().hasAny(['mapa_precios']) || request.resource.data.mapa_precios.size() <= 1000)
                          && (
                               !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado_moderacion']) || 
                               request.resource.data.estado_moderacion == 'en_revision_kyc'
                             )
                        )
                        // Permite al cajero incrementar facturas sin colapso de affectedKeys
                        || (
                            isEmployeeOf(userId)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['facturacion_control'])
                            && request.resource.data.facturacion_control.facturas_emitidas_mes is number
                            && (!('facturacion_control' in resource.data) || !('facturas_cupo_gratis' in resource.data.facturacion_control) || request.resource.data.facturacion_control.facturas_cupo_gratis == resource.data.facturacion_control.facturas_cupo_gratis)
                            && (!('facturacion_control' in resource.data) || !('facturas_prepago_saldo' in resource.data.facturacion_control) || request.resource.data.facturacion_control.facturas_prepago_saldo == resource.data.facturacion_control.facturas_prepago_saldo)
                        )
                      ) 
                      || isModeradorOrAdmin();
                    
      // BORRADO
      allow delete: if isOwner(userId) || isModeradorOrAdmin();

      // --------------------------------------------------------
      // SUBCOLECCIONES DE CATÁLOGO, LOGÍSTICA Y PEDIDOS
      // --------------------------------------------------------
      match /productos/{productoId} {
          allow create, update: if isSuperAdmin()
                      || (
                        (isOwner(userId) || isEmployeeOf(userId))
                        && request.resource.data.keys().hasAll(['nombre', 'precio'])
                        && isValidString(request.resource.data.nombre, 1, 150)
                        && request.resource.data.precio is number
                        && request.resource.data.precio >= 0
                        && (!request.resource.data.keys().hasAny(['stock_actual']) || request.resource.data.stock_actual is number)
                        && (!request.resource.data.keys().hasAny(['cuerpo_articulo']) || isValidString(request.resource.data.cuerpo_articulo, 0, 500))
                        && (!request.resource.data.keys().hasAny(['cuerpo_texto']) || isValidString(request.resource.data.cuerpo_texto, 0, 2000))
                        && (!request.resource.data.keys().hasAny(['imagen']) || isValidString(request.resource.data.imagen, 0, 2048))
                      );
                      
          allow delete: if isSuperAdmin() || isOwner(userId);

          // SUBCOLECCIÓN DE BINS Y ESTANTES FÍSICOS
          match /stock_ubicaciones/{ubicacionId} {
              allow read: if true;
              allow write: if isSuperAdmin() || isOwner(userId) || isEmployeeOf(userId);
          }
      }

      // HISTORIAL DE KARDEX Y MOVIMIENTOS FÍSICOS
      match /Movimientos_Kardex/{movId} {
          allow read: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();
          allow create: if isSuperAdmin() || isOwner(userId) || isEmployeeOf(userId);
          allow update, delete: if false;
      }

      // SEDES Y ALMACENES SECUNDARIOS
      match /Sedes_Almacenes/{sedeId} {
          allow read: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();
          allow write: if isOwner(userId) || isModeradorOrAdmin();
      }

      match /Tareas_Internas/{tareaId} {
          allow read, write: if isOwner(userId) 
                             || isEmployeeOf(userId)
                             || isModeradorOrAdmin();
      }

      match /comisiones_referidos/{txId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
                        && request.resource.data.keys().hasAll(['codigo_tx', 'monto_venta', 'comision_ganada', 'estado', 'fecha', 'moneda'])
                        && request.resource.data.monto_venta is number
                        && request.resource.data.monto_venta >= (request.resource.data.moneda == 'USD' ? 7 : 30000)
                        && request.resource.data.comision_ganada is number
                        && request.resource.data.comision_ganada >= 0
                        && request.resource.data.comision_ganada <= (request.resource.data.monto_venta * 0.11)
                        && request.resource.data.estado == 'validado';
          allow update, delete: if false; 
      }

      match /pedidos_entrantes/{ticketId} {
          allow create: if true;
          allow read, update, delete: if isOwner(userId) || isEmployeeOf(userId);
      }

      // PLANOS MULTI-SEDE
      match /Planos_Almacenes/{almacenId} {
          allow read: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();
          allow write: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();
      }

      // PLANOS TOPOGRÁFICOS Y CATASTRO
      match /Planos_Topograficos/{planoId} {
          allow read: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();
          allow create, update: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();
          allow delete: if isOwner(userId) || isModeradorOrAdmin();
      }

      match /Historial_Descargas_PDF/{descargaId} {
          allow read, create: if isOwner(userId) || isEmployeeOf(userId);
          allow update, delete: if false;
      }

      // --------------------------------------------------------
      // REGLAS DE FACTURACIÓN POS, CAJA Y CIERRES Z
      // --------------------------------------------------------
      match /Ventas_POS/{ticketId} {
        allow get: if true;
        allow list: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();

        allow create: if (isOwner(userId) || isEmployeeOf(userId))
                      && request.resource.data.keys().hasAll(['total', 'productos', 'metodo_pago', 'timestamp_caja'])
                      && request.resource.data.total is number
                      && request.resource.data.total >= 0
                      && request.resource.data.productos.size() > 0;
        
        allow update: if (isOwner(userId) || isEmployeeOf(userId))
                      && resource.data.anulado != true
                      && request.resource.data.anulado == true
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'anulado', 
                          'motivo_anulacion', 
                          'timestamp_anulacion', 
                          'usuario_anulacion'
                      ]);

        allow delete: if false;
      }

      match /Sesiones_Caja/{sesionId} {
        allow read: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();
        allow create, update: if isOwner(userId) || isEmployeeOf(userId);
        allow delete: if false;
      }

      match /Informes_X/{informeId} {
        allow read: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();
        allow create, update: if isOwner(userId) || isEmployeeOf(userId);
        allow update, delete: if false;
      }

      match /Cierres_Z/{cierreId} {
        allow read: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();
        allow create: if (isOwner(userId) || isEmployeeOf(userId))
                      && request.resource.data.keys().hasAll(['id_sesion', 'esperado_efectivo', 'contado_efectivo'])
                      && request.resource.data.contado_efectivo is number;
        allow update, delete: if false;
      }

      match /Notas_Credito_POS/{notaId} {
        allow read: if isOwner(userId) || isEmployeeOf(userId) || isModeradorOrAdmin();
        allow create: if (isOwner(userId) || isEmployeeOf(userId))
                      && request.resource.data.keys().hasAll(['ticket_origen_id', 'motivo'])
                      && (request.resource.data.keys().hasAny(['total_revertido', 'total_reembolsado']));
        allow update, delete: if false;
      }

      // PERSONAL (Soporte simultáneo para Equipo y Colaboradores)
      match /Equipo/{empleadoId} {
        allow read: if isOwner(userId) || isEmployeeOf(userId);
        allow write: if isOwner(userId) || isModeradorOrAdmin();
      }

      match /Colaboradores/{colabId} {
        allow read: if isOwner(userId) || isEmployeeOf(userId);
        allow write: if isOwner(userId) || isModeradorOrAdmin();
      }
    }

    // ==========================================================
    // 2. ÍNDICE GLOBAL DE OPERADORES
    // ==========================================================
    match /Usuarios_Operadores/{operadorUid} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() 
                    && (request.auth.uid == operadorUid || isModeradorOrAdmin())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'requiere_cambio_password',
                        'expiracion_clave_temporal',
                        'fecha_ultimo_cambio_password'
                    ]);
      allow create, delete: if isModeradorOrAdmin();
    }

    // ==========================================================
    // 3. LOGÍSTICA E INVENTARIO GENERAL
    // ==========================================================
    match /Almacenes/{almacenId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.id_negocio_padre == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.id_negocio_padre == request.auth.uid;
    }

    match /Historial_Jornadas/{jornadaId} {
        allow create: if isAuthenticated() && request.resource.data.uid_conductor == request.auth.uid;
        allow read: if isAuthenticated() && resource.data.uid_conductor == request.auth.uid;
        allow update, delete: if false;
    }

    // ==========================================================
    // 4. COLECCIONES DE CONTROL, SEGURIDAD Y RRHH
    // ==========================================================
    match /Boveda_Rechazos/{docId} {
      allow read, write: if isModeradorOrAdmin();
    }

    match /Lista_Negra/{docId} {
      allow read, write: if isModeradorOrAdmin();
    }

    match /Usuarios_Admin/{uid} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ==========================================================
    // 5. COLECCIONES DE SISTEMA Y MARKETING
    // ==========================================================
    match /Pulso_Urbano/{noticiaId} {
      allow read: if true;
      allow write: if isModeradorOrAdmin(); 
    }

    match /Caballo_Troya/{bannerId} {
      allow read: if true;
      allow write: if false; 
    }

    match /informacion_general/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================================
    // 6. BÓVEDA DE CONFIGURACIÓN Y MÉTRICAS GLOBALES
    // ==========================================================
    match /Sistema/Configuracion {
        allow read: if true;
        allow write: if isSuperAdmin();
    }

    match /sistema/metricas_red {
        allow read: if true;
        allow create, update: if isAuthenticated();
    }

    match /Sistema/{document=**} {
      allow read, write: if false; 
    }

    // ==========================================================
    // 7. ADUANA JURÍDICA Y BÓVEDA DE TRÁMITES (P2P)
    // ==========================================================
    match /Boveda_Tramites/{tramiteId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantes;
      allow write: if false; 
    }

    match /Llaves_Maestras/{llaveId} {
      allow read, write: if false;
    }
    
    // ==========================================================
    // 8. INFRAESTRUCTURA DE SEGURIDAD OTP
    // ==========================================================
    match /Sistema_OTP/{userId} {
      allow read, write: if false; 
    }

    match /Salas_Legales_P2P/{salaId} {
      allow read: if true; 
      allow write: if false;
    }

    // ==========================================================
    // 9. NÚCLEO LOGÍSTICO (RADAR Y ESCROW)
    // ==========================================================
    match /Logistica_Ordenes/{ordenId} {
      allow read: if isVerified();
      allow write: if false; 
    }

    // ==========================================================
    // 10. TELEMETRÍA Y ALERTAS DE SEGURIDAD WMS
    // ==========================================================
    match /Estadisticas_Empresa/{docId} {
        allow read: if isAuthenticated();
        allow write: if isModeradorOrAdmin();
    }

    match /Alertas_Seguridad/{alertaId} {
        allow read: if isAuthenticated() && (
            resource.data.id_negocio == request.auth.uid 
            || isEmployeeOf(resource.data.id_negocio) 
            || isModeradorOrAdmin()
        );
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (
            resource.data.id_negocio == request.auth.uid 
            || isEmployeeOf(resource.data.id_negocio) 
            || isModeradorOrAdmin()
        );
        allow delete: if isModeradorOrAdmin();
    }
  }
}
